# server
PORT=4000
PUBLIC_URL=http://localhost:4000
# leave empty to use a throwaway in-memory mongo (data resets on restart)
# or paste your Atlas / local uri here, eg mongodb://127.0.0.1:27017/agentliability
MONGODB_URI=

# secrets (already generated for you, change them before deploying)
SIGNING_SEED=change-me
AUDIT_HMAC_SECRET=change-me

# paypal sandbox. leave blank = simulated mode, everything still works locally
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_MODE=auto

# ai verifier. blank = rule based verdicts only
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# misc
ALLOW_DEMO_RESET=true
AUTO_DISPUTE_ACTIONS=true
ALLOW_UNSIGNED_WEBHOOKS=false
